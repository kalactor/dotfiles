#!/usr/bin/env bash
# rice-screenshot — region/output/window/full screenshots and OCR.
#
# Usage: rice-screenshot [region|output|window|full|ocr]
#
# region  select an area with slurp
# output  select a monitor or an area with slurp -o -r
# window  snap to a visible window on an active workspace
# full    capture every monitor
# ocr     select an area, copy its text to the clipboard and save the image
set -uo pipefail

DIR="${RICE_SCREENSHOT_DIR:-$HOME/Pictures/Screenshots}"
MODE="${1:-region}"

usage() {
    cat <<'EOF'
Usage: rice-screenshot [region|output|window|full|ocr]

  region   select an area (default)
  output   select a monitor or an area
  window   select a visible window
  full     capture every monitor
  ocr      copy text from a selected area
EOF
}

die() {
    printf 'rice-screenshot: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "Screenshot" "$@" 2>/dev/null || true
}

unique_file() {
    local base file n=1
    base=$(date +%Y%m%d_%H%M%S)
    file="$DIR/$base.png"
    while [ -e "$file" ]; do
        file="$DIR/${base}-${n}.png"
        n=$((n + 1))
    done
    printf '%s\n' "$file"
}

window_rects() {
    python3 - <<'PY'
import json
import subprocess
import sys

def query(*args):
    result = subprocess.run(args, check=True, capture_output=True, text=True)
    return json.loads(result.stdout)

clients = query("hyprctl", "clients", "-j")
monitors = query("hyprctl", "monitors", "-j")
active = {
    (monitor.get("activeWorkspace") or {}).get("id")
    for monitor in monitors
}

rects = []
for client in clients:
    if not client.get("mapped") or client.get("hidden"):
        continue
    workspace = (client.get("workspace") or {}).get("id")
    if workspace not in active:
        continue
    at = client.get("at") or [0, 0]
    size = client.get("size") or [0, 0]
    if size[0] < 1 or size[1] < 1:
        continue
    rects.append(f"{at[0]},{at[1]} {size[0]}x{size[1]}")

if not rects:
    sys.exit(1)
print("\n".join(rects))
PY
}

select_window() {
    local rects
    rects=$(window_rects) || return 1
    printf '%s\n' "$rects" | slurp -r
}

capture() {
    local mode="$1" file geometry
    file=$(unique_file)
    case "$mode" in
        region)
            geometry=$(slurp) || return 0
            [ -n "$geometry" ] || return 0
            grim -g "$geometry" "$file" || return 1
            ;;
        output)
            geometry=$(slurp -o -r) || return 0
            [ -n "$geometry" ] || return 0
            grim -g "$geometry" "$file" || return 1
            ;;
        window)
            geometry=$(select_window) || return 0
            [ -n "$geometry" ] || return 0
            grim -g "$geometry" "$file" || return 1
            ;;
        full)
            grim "$file" || return 1
            ;;
    esac
    printf '%s\n' "$file"
}

annotate() {
    local file="$1" edited
    command -v satty >/dev/null 2>&1 || return 0
    edited="${file%.png}-annotated.png"
    satty --filename "$file" \
        --output-filename "$edited" \
        --copy-command wl-copy \
        --early-exit \
        --actions-on-escape exit \
        >/dev/null 2>&1 || true
    if [ -s "$edited" ]; then
        notify -i "$edited" "Screenshot annotated" "$edited"
    fi
}

prompt_annotate() {
    local file="$1" action=""
    if command -v notify-send >/dev/null 2>&1; then
        action=$(notify-send -a "Screenshot" -i "$file" -t 5000 \
            -h string:x-canonical-private-synchronous:rice-screenshot \
            -A "annotate=Annotate" \
            "Screenshot copied" "$file" 2>/dev/null) || action=""
    fi
    if [ "$action" = "annotate" ]; then
        annotate "$file"
    fi
}

ocr() {
    local geometry file text lang="eng" words
    geometry=$(slurp) || return 0
    [ -n "$geometry" ] || return 0
    file=$(unique_file)
    grim -g "$geometry" "$file" || die "grim failed"
    if tesseract --list-langs 2>/dev/null | grep -qx 'hin'; then
        lang="eng+hin"
    fi
    text=$(tesseract "$file" stdout -l "$lang" 2>/dev/null) || text=""
    if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
        notify -i "$file" "OCR: no text found" "$file"
        return 0
    fi
    printf '%s' "$text" | wl-copy || die "could not copy OCR text"
    words=$(printf '%s' "$text" | wc -w | tr -d ' ')
    notify -i "edit-copy" "OCR text copied" "$words words from $file"
    printf '%s\n' "$text"
}

need grim
need slurp
need wl-copy
mkdir -p "$DIR" || die "cannot create $DIR"

case "$MODE" in
    region|output|window|full)
        file=$(capture "$MODE") || {
            notify -i "dialog-error" "Screenshot failed" "Could not capture the screen"
            exit 1
        }
        [ -n "$file" ] || exit 0
        if ! wl-copy -t image/png < "$file"; then
            notify -i "$file" "Screenshot saved" "Clipboard copy failed: $file"
            exit 1
        fi
        prompt_annotate "$file"
        ;;
    ocr)
        need tesseract
        ocr
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
