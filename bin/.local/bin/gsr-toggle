#!/bin/bash
if pgrep -f gpu-screen-recorder >/dev/null; then
  pkill -SIGINT -f gpu-screen-recorder        # stop + save
else
  mon=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
  f=$HOME/Videos/rec-$(date +%Y%m%d_%H%M%S).mp4
  gpu-screen-recorder -w "$mon" -f 60 -a default_output -o "$f" && notify-send "Recording saved" "$f"
fi
