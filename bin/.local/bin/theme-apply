#!/usr/bin/env bash
# usage: theme-apply IMAGE [light|dark]
# One wallpaper change recolors every app: wallust -> all templates -> reload.
# If MODE is omitted, ~/.cache/rice/effective-mode is used (dark as fallback).
set -uo pipefail

img="${1:?usage: theme-apply IMAGE [light|dark]}"
[ -f "$img" ] || { notify-send -u critical "theme-apply" "No such image: $img"; exit 1; }

mode="${2:-}"
if [ -z "$mode" ]; then
  mode=$(cat "$HOME/.cache/rice/effective-mode" 2>/dev/null || true)
fi
case "$mode" in
  light|dark) ;;
  *) mode=dark ;;
esac

mkdir -p "$HOME/.cache/rice"

# Serialize theme generation: the timer and a keybind can race.
exec 9>"$HOME/.cache/rice/theme.lock"
flock -w 60 9 || { notify-send -u critical "theme-apply" "Timed out waiting for theme lock"; exit 1; }

failures=()
record_failure() {
    failures+=("$1")
    printf 'theme-apply: %s\n' "$1" >&2
}

# 1. Generate the base palette with wallust.  The full wallust.toml also
# lists semantic templates that wallust cannot render (it only knows the
# base keys), so render the base palette through a minimal config first.
# rice-contrast renders the full manifest after contrast enforcement.
base_dir="$HOME/.cache/rice/wallust-base"
rm -rf "$base_dir"
mkdir -p "$base_dir/templates"
if ! cp "$HOME/.config/wallust/templates/palette.env" "$base_dir/templates/palette.env"; then
  notify-send -u critical "theme-apply" "wallust palette template missing"
  exit 1
fi
printf "[templates]\npalette.template = 'palette.env'\npalette.target = '%s'\n" \
  "$HOME/.cache/rice/colors.env" > "$base_dir/wallust.toml"
if ! wallust run --config-dir "$base_dir" --skip-sequences --palette "$mode" "$img" >/dev/null 2>&1; then
  notify-send -u critical "theme-apply" "wallust failed for $img ($mode)"
  exit 1
fi

# 1b. Ask wallust for ANSI-preserving hues (red/green/yellow/blue/...), then
# let rice-contrast enforce WCAG contrast against the composited terminal
# background and re-render every template with semantic colours.  The second
# wallust call only prints a palette; it does not touch templates or the
# current terminal.
ansi_scheme="$HOME/.cache/rice/ansi-scheme"
rm -f "$ansi_scheme"
if wallust run --quiet --skip-templates --skip-sequences --print-scheme --no-cache \
     --palette ansidark16 --colorspace lchansi "$img" > "$ansi_scheme.tmp" 2>/dev/null; then
  mv -f "$ansi_scheme.tmp" "$ansi_scheme"
else
  rm -f "$ansi_scheme.tmp"
  record_failure "wallust ANSI palette generation failed"
fi

if [ -x "$HOME/.local/bin/rice-contrast" ]; then
  if ! "$HOME/.local/bin/rice-contrast" --image "$img" --mode "$mode" --ansi "$ansi_scheme"; then
    record_failure "contrast enforcement failed"
  fi
else
  record_failure "rice-contrast missing"
fi

# wallust's vim template does not know about the mode; fix the background so
# light palettes do not get dark-mode syntax defaults.
if [ -f "$HOME/.vim/colors/wallust.vim" ]; then
  sed -i "s/^set background=.*/set background=$mode/" "$HOME/.vim/colors/wallust.vim"
fi

# hyprlock dims the current wallpaper before drawing text. A light palette
# needs almost no dimming, while a dark palette needs a stronger scrim.
hl_colors="$HOME/.config/hypr/hyprlock-colors.conf"
if [ -f "$hl_colors" ]; then
  if [ "$mode" = "light" ]; then scrim=0.90; clock_var=muted; else scrim=0.55; clock_var=foreground; fi
  sed -i '/^\$scrim[[:space:]]*=/d; /^\$clock[[:space:]]*=/d' "$hl_colors"
  printf '$scrim = %s\n' "$scrim" >> "$hl_colors"
  clock_hex=$(awk -F'[()]' -v var="$clock_var" '$1 ~ ("\\$" var) {print $2; exit}' "$hl_colors")
  [ -n "$clock_hex" ] && printf '$clock = rgba(%s)\n' "$clock_hex" >> "$hl_colors"
fi

# 2. GTK 3/4 follow gsettings on Wayland (settings.ini is ignored there).
if command -v gsettings >/dev/null 2>&1; then
  gtk_failed=0
  if [ "$mode" = "light" ]; then
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita 2>/dev/null || gtk_failed=1
    gsettings set org.gnome.desktop.interface icon-theme Papirus 2>/dev/null || gtk_failed=1
    gsettings set org.gnome.desktop.interface color-scheme default 2>/dev/null || gtk_failed=1
  else
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark 2>/dev/null || gtk_failed=1
    gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark 2>/dev/null || gtk_failed=1
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || gtk_failed=1
  fi
  [ "$gtk_failed" -eq 0 ] || record_failure "could not update all GTK settings"
fi

# 3. Qt: qt6ct + Kvantum. New Qt apps pick this up; running ones keep their
# current style until reopened.
qt_conf="$HOME/.config/qt6ct/qt6ct.conf"
if [ "$mode" = "light" ]; then
  qt_icon="Papirus"
else
  qt_icon="Papirus-Dark"
fi

mkdir -p "$(dirname "$qt_conf")"
if [ -f "$qt_conf" ]; then
  sed -i -E "s/^icon_theme=.*/icon_theme=$qt_icon/" "$qt_conf"
else
  cat > "$qt_conf" <<EOF
[Appearance]
style=kvantum
icon_theme=$qt_icon
standard_dialogs=default
custom_palette=false

[Fonts]
general="Inter,11,-1,5,50,0,0,0,0,0"
fixed="JetBrainsMono Nerd Font,11,-1,5,50,0,0,0,0,0"
EOF
fi

# KDE reads the generated colour scheme; Kvantum paints its own surfaces and
# selection from the theme SVG, so kde-theme bakes the wallust palette into both.
if [ -x "$HOME/.local/bin/kde-theme" ] && "$HOME/.local/bin/kde-theme" "$mode"; then
  :
else
  record_failure "kde-theme failed; used a stock Kvantum fallback"
  notify-send -u normal "theme-apply" "kde-theme failed; using a stock Kvantum theme"
  kv_conf="$HOME/.config/Kvantum/kvantum.kvconfig"
  if [ "$mode" = "light" ]; then kv_theme="KvArc"; else kv_theme="KvArcDark"; fi
  mkdir -p "$(dirname "$kv_conf")"
  if [ -f "$kv_conf" ]; then
    sed -i -E "s/^theme=.*/theme=$kv_theme/" "$kv_conf"
  else
    printf '[General]\ntheme=%s\n' "$kv_theme" > "$kv_conf"
  fi
fi

# Dolphin's global view properties live in an xattr. Seed the compact Details
# view on first use; the helper refuses to overwrite a user choice.
if [ -x "$HOME/.local/bin/dolphin-view-defaults" ]; then
  "$HOME/.local/bin/dolphin-view-defaults" >/dev/null 2>&1 \
    || record_failure "Dolphin view defaults failed"
fi

# Telegram Desktop watches its generated theme file and reloads it live after
# the one-time `telegram-theme --install` activation.
if [ -x "$HOME/.local/bin/telegram-theme" ]; then
  "$HOME/.local/bin/telegram-theme" "$mode" --wallpaper "$img" >/dev/null 2>&1 \
    || record_failure "Telegram theme generation/sync failed"
fi

# 4. SDDM is system-level. If the theme directory is user-writable (installed
# with the chown from system/sddm/README.md), keep its wallpaper and palette in
# sync automatically; otherwise leave it untouched.
sddm_theme="/usr/share/sddm/themes/rice"
if [ -w "$sddm_theme" ] && [ -f "$HOME/.cache/rice/Colors.qml" ]; then
  cp -f "$HOME/.cache/rice/Colors.qml" "$sddm_theme/Colors.qml" \
    && cp -f "$img" "$sddm_theme/background.jpg" \
    || record_failure "SDDM palette/wallpaper copy failed"
fi

# 5. GTK 3/4 cannot reload gtk.css in place. Restart the common, stateless
# settings apps so they pick up the new palette; other GTK apps do so when
# reopened. Set RICE_GTK_RESTART=0 to skip this.
if [ "${RICE_GTK_RESTART:-1}" != "0" ] && [ -x "$HOME/.local/bin/rice-gtk-reload" ]; then
  "$HOME/.local/bin/rice-gtk-reload" >/dev/null 2>&1 \
    || record_failure "GTK application reload failed"
fi

# 6. Reload apps that do not watch their own config
if hyprctl monitors >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || record_failure "Hyprland reload failed"
fi
pkill -SIGUSR1 kitty 2>/dev/null || true        # kitty reloads its config
swaync-client -rs >/dev/null 2>&1 || true       # SwayNC reloads CSS
pkill -USR2 -x btop 2>/dev/null || true         # btop re-reads config + active theme
[ -f "$HOME/.config/cava/config" ] && touch "$HOME/.config/cava/config"  # cava live-config reload
# Waybar watches style.css for changes and reloads its imported colors.css.
# Touch it as well as signalling: at login the signal can arrive while the
# bar is still initialising, leaving the previous palette on screen.
waybar_style="$HOME/.config/waybar/style.css"
[ -f "$waybar_style" ] && touch "$waybar_style"
pkill -USR2 -x waybar 2>/dev/null || true
if [ -f "$waybar_style" ]; then
  sleep 0.25
  touch "$waybar_style"
fi

# 7. User hooks: every executable in the folder gets the image path as $1 and
# the palette mode as $RICE_MODE.
export RICE_MODE="$mode"
hooks="$HOME/.config/rice/hooks/theme-set.d"
if [ -d "$hooks" ]; then
  for h in "$hooks"/*; do
    if [ -x "$h" ]; then
      "$h" "$img" 9>&- || record_failure "theme hook failed: ${h##*/}"
    fi
  done
fi

if (( ${#failures[@]} != 0 )); then
  summary=$(printf '%s; ' "${failures[@]}")
  notify-send -u critical "theme-apply" "Theme applied with errors: $summary" 2>/dev/null || true
  # Do not mark a partial update complete: `wall ensure-mode` will retry it.
  exit 1
fi

printf '%s\n' "$mode" > "$HOME/.cache/rice/theme-mode.tmp"
mv -f "$HOME/.cache/rice/theme-mode.tmp" "$HOME/.cache/rice/theme-mode"
