#!/usr/bin/env bash
# rice-doctor — is the desktop installed, generated and running?
set -uo pipefail

ok()  { printf '  \033[32m✔\033[0m %s\n' "$1"; }
bad() { printf '  \033[31m✘\033[0m %s\n' "$1"; }
warn(){ printf '  \033[33m•\033[0m %s\n' "$1"; }

echo "Commands:"
for c in hyprctl waybar swaync swaync-client rofi wlogout wallust hyprpaper \
         hyprlock hypridle sddm kitty vim grim slurp satty wl-copy cliphist \
         gpu-screen-recorder swayimg jq notify-send powerprofilesctl pamixer \
         gnome-keyring-daemon hyprsunset swayosd-server ddcutil hyprpicker \
         qt6ct kvantummanager btop cava rice-gtk-reload rice-mode wall theme-apply \
         kde-theme dolphin-view-defaults telegram-theme; do
    command -v "$c" >/dev/null 2>&1 && ok "$c" || bad "$c missing"
done

echo "Services:"
for s in hyprpolkitagent xdg-desktop-portal-hyprland pipewire wireplumber; do
    systemctl --user is-active --quiet "$s" && ok "user/$s" || bad "user/$s inactive"
done
for s in NetworkManager bluetooth cups; do
    systemctl is-active --quiet "$s" && ok "system/$s" || bad "system/$s inactive"
done
systemctl --user is-active --quiet rice-sun.timer && ok "user/rice-sun.timer active" || bad "user/rice-sun.timer inactive"
systemctl --user is-enabled --quiet rice-sun.timer && ok "user/rice-sun.timer enabled" || warn "user/rice-sun.timer not enabled"

echo "Processes:"
for p in Hyprland waybar swaync hyprpaper hypridle; do
    pgrep -x "$p" >/dev/null && ok "$p running" || bad "$p not running"
done
pgrep -x udiskie >/dev/null && ok "udiskie running" || warn "udiskie not running (optional)"

echo "Waybar outputs:"
if hyprctl layers -j 2>/dev/null | jq -e 'to_entries[] | select(.key=="DP-3") | .value.levels[][] | select(.namespace=="waybar")' >/dev/null; then
    ok "waybar on DP-3"
else
    bad "waybar missing on DP-3"
fi
if hyprctl layers -j 2>/dev/null | jq -e 'to_entries[] | select(.key=="HDMI-A-1") | .value.levels[][] | select(.namespace=="waybar")' >/dev/null 2>&1; then
    bad "waybar leaked onto HDMI-A-1"
else
    ok "no waybar on HDMI-A-1"
fi

echo "Generated theme files:"
for f in "$HOME/.config/waybar/colors.css" \
         "$HOME/.config/swaync/colors.css" \
         "$HOME/.config/hypr/colors.lua" \
         "$HOME/.config/hypr/hyprlock-colors.conf" \
         "$HOME/.config/kitty/colors.conf" \
         "$HOME/.config/rofi/colors.rasi" \
         "$HOME/.config/gtk-3.0/gtk.css" \
         "$HOME/.config/gtk-4.0/gtk.css" \
         "$HOME/.vim/colors/wallust.vim" \
         "$HOME/.config/starship.toml" \
         "$HOME/.config/btop/themes/wallust.theme" \
         "$HOME/.config/cava/themes/wallust" \
         "$HOME/.cache/rice/Colors.qml" \
         "$HOME/.config/wlogout/colors.css" \
         "$HOME/.cache/rice/colors.env" \
         "$HOME/.cache/rice/telegram.tdesktop-theme" \
         "$HOME/.local/share/rice/telegram-base.tdesktop-palette" \
         "$HOME/.config/kdeglobals" \
         "$HOME/.config/Kvantum/kvantum.kvconfig" \
         "$HOME/.config/Kvantum/WallustFlat/WallustFlat.kvconfig" \
         "$HOME/.config/Kvantum/WallustFlat/WallustFlat.svg"; do
    [ -s "$f" ] && ok "${f#$HOME/}" || bad "${f#$HOME/} missing"
done

echo "Hyprland config:"
if [ -z "$(hyprctl configerrors 2>/dev/null)" ]; then
    ok "hyprctl configerrors clean"
else
    bad "hyprctl configerrors not clean"
    hyprctl configerrors
fi

echo "Symlinks:"
for p in hypr waybar kitty swaync rofi wallust swayimg wlogout rice btop cava; do
    [ -L "$HOME/.config/$p" ] && ok "~/.config/$p -> $(readlink "$HOME/.config/$p")" || bad "~/.config/$p is not a symlink"
done
[ -L "$HOME/.vimrc" ] && ok "~/.vimrc -> $(readlink "$HOME/.vimrc")" || bad "~/.vimrc is not a symlink"
[ -L "$HOME/.config/mpv/mpv.conf" ] && ok "~/.config/mpv/mpv.conf -> $(readlink "$HOME/.config/mpv/mpv.conf")" || bad "~/.config/mpv/mpv.conf is not a symlink"
[ -L "$HOME/.config/chrome-flags.conf" ] && ok "~/.config/chrome-flags.conf -> $(readlink "$HOME/.config/chrome-flags.conf")" || bad "~/.config/chrome-flags.conf is not a symlink"
[ -L "$HOME/.config/dolphinrc" ] && ok "~/.config/dolphinrc -> $(readlink "$HOME/.config/dolphinrc")" || bad "~/.config/dolphinrc is not a symlink"
[ -L "$HOME/.local/bin/kde-theme" ] && ok "~/.local/bin/kde-theme" || bad "~/.local/bin/kde-theme is not a symlink"
[ -L "$HOME/.local/bin/dolphin-view-defaults" ] && ok "~/.local/bin/dolphin-view-defaults" || bad "~/.local/bin/dolphin-view-defaults is not a symlink"
[ -L "$HOME/.local/bin/telegram-theme" ] && ok "~/.local/bin/telegram-theme" || bad "~/.local/bin/telegram-theme is not a symlink"
[ -L "$HOME/.local/share/rice/telegram-base.tdesktop-palette" ] && ok "~/.local/share/rice/telegram-base.tdesktop-palette" || bad "telegram base palette is not a symlink"
[ -L "$HOME/.config/systemd/user/rice-sun.service" ] && ok "~/.config/systemd/user/rice-sun.service" || bad "rice-sun.service is not a symlink"
[ -L "$HOME/.config/systemd/user/rice-sun.timer" ] && ok "~/.config/systemd/user/rice-sun.timer" || bad "rice-sun.timer is not a symlink"
[ -L "$HOME/.local/bin/rice-mode" ] && ok "~/.local/bin/rice-mode" || bad "~/.local/bin/rice-mode is not a symlink"

echo "Wallpaper state:"
if [ -L "$HOME/.cache/rice/wallpaper" ] && [ -f "$HOME/.cache/rice/wallpaper" ]; then
    ok "persisted -> $(readlink "$HOME/.cache/rice/wallpaper")"
else
    bad "~/.cache/rice/wallpaper missing"
fi

echo "Light/dark mode:"
if command -v rice-mode >/dev/null 2>&1; then
    mode_json=$(rice-mode status --json 2>/dev/null) || mode_json=""
    if [ -n "$mode_json" ]; then
        mode=$(jq -r '.mode' <<<"$mode_json")
        effective=$(jq -r '.effective' <<<"$mode_json")
        ok "mode=$mode effective=$effective"
        sunrise=$(jq -r '.sunrise // empty' <<<"$mode_json")
        sunset=$(jq -r '.sunset // empty' <<<"$mode_json")
        [ -n "$sunrise" ] && ok "sunrise $sunrise" || warn "sunrise unavailable"
        [ -n "$sunset" ] && ok "sunset $sunset" || warn "sunset unavailable"
        ok "location $(jq -r '.location' <<<"$mode_json")"
        wallpaper=$(jq -r '.wallpaper // empty' <<<"$mode_json")
        case "$wallpaper" in
            "$HOME/Pictures/walls/$effective"/*) ok "wallpaper matches $effective mode" ;;
            "") bad "no wallpaper for $effective mode" ;;
            *) bad "wallpaper is outside $effective mode: $wallpaper" ;;
        esac
    else
        bad "rice-mode status failed"
    fi
else
    bad "rice-mode missing"
fi
[ -s "$HOME/.cache/rice/location" ] && ok "location persisted" || warn "location not persisted (using default)"
theme_mode=$(cat "$HOME/.cache/rice/theme-mode" 2>/dev/null || true)
effective_now=$(rice-mode current 2>/dev/null || true)
if [ -n "$effective_now" ] && [ "$theme_mode" = "$effective_now" ]; then
    ok "generated theme matches $effective_now"
else
    bad "theme-mode=${theme_mode:-missing} effective=${effective_now:-unknown}"
fi
kv_theme=$(sed -n 's/^theme=//p' "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null | head -1)
[ "$kv_theme" = "WallustFlat" ] && ok "Kvantum theme WallustFlat" || bad "Kvantum theme=${kv_theme:-missing}"
kde_icon=$(sed -n '/^\[Icons\]/,/^\[/s/^Theme=//p' "$HOME/.config/kdeglobals" 2>/dev/null | head -1)
case "$effective_now" in
    light) [ "$kde_icon" = "Papirus" ] && ok "KDE icons Papirus" || bad "KDE icons=${kde_icon:-missing} for light" ;;
    dark)  [ "$kde_icon" = "Papirus-Dark" ] && ok "KDE icons Papirus-Dark" || bad "KDE icons=${kde_icon:-missing} for dark" ;;
esac

echo "Telegram:"
if command -v telegram-theme >/dev/null 2>&1; then
    if telegram-theme --status >/dev/null 2>&1; then
        ok "custom theme installed and in sync"
    else
        warn "not installed or stale (run: telegram-theme --install)"
    fi
else
    bad "telegram-theme missing"
fi
