    lines: list[str] = []
    for section, values in sections.items():
        lines.append(f"[{section}]")
        for key, value in values.items():
            lines.append(f"{key}={value}")
        lines.append("")

    target = HOME / ".config" / "kdeglobals"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join(lines))


def write_kvantum(palette: dict[str, str], mode: str) -> None:
    bg = palette["background"]
    fg = palette["foreground"]
    c0 = palette["color0"]
    c3 = palette["color3"]
    c4 = palette["color4"]
    c5 = palette["color5"]
    c8 = palette["color8"]
    sel_fg = contrast_text(c3, palette)
    theme_name = "WallustFlat"
    # KvFlatLight ships a dark toolbar/URL field with dark icons, which is hard
    # to read. KvArc keeps the light chrome light; KvFlat is the flatter dark
    # base and matches the rest of the rice.
    base_name = "KvArc" if mode == "light" else "KvFlat"
    base_dir = Path("/usr/share/Kvantum") / base_name
    if not (base_dir / f"{base_name}.svg").is_file():
        raise SystemExit(f"kde-theme: missing base theme {base_dir}")

    colors = {
        "window.color": c0,
        "base.color": bg,
        "alt.base.color": mix(bg, c0, 0.60),
        "button.color": c0,
        "light.color": mix(c0, fg, 0.25),
        "mid.light.color": mix(c0, fg, 0.12),
        "dark.color": mix(bg, "#000000", 0.15),
        "mid.color": c0,
        "highlight.color": c3,
        "inactive.highlight.color": mix(c3, bg, 0.35),
        "text.color": fg,
        "window.text.color": fg,
        "button.text.color": fg,
        "disabled.text.color": c8,
        "tooltip.text.color": fg,
        "highlight.text.color": sel_fg,
        "link.color": c4,
        "link.visited.color": c5,
        "progress.indicator.text.color": sel_fg,
    }

    target_dir = HOME / ".config" / "Kvantum" / theme_name
    target_dir.mkdir(parents=True, exist_ok=True)

    config_text = (base_dir / f"{base_name}.kvconfig").read_text()
    (target_dir / f"{theme_name}.kvconfig").write_text(
        replace_general_colors(config_text, colors)
    )

    svg = (base_dir / f"{base_name}.svg").read_text()
    accent = base_accent(svg)
    (target_dir / f"{theme_name}.svg").write_text(
        recolor_svg(svg, palette, accent, mode)
    )

    kv_config = HOME / ".config" / "Kvantum" / "kvantum.kvconfig"
    kv_config.parent.mkdir(parents=True, exist_ok=True)
    kv_config.write_text(f"[General]\ntheme={theme_name}\n")


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode not in ("light", "dark"):
        mode = (CACHE / "effective-mode").read_text().strip()
    if mode not in ("light", "dark"):
        mode = "dark"
    palette = read_palette()
    write_kdeglobals(palette, mode)
    write_kvantum(palette, mode)
    print(f"kde-theme: wrote KDE/Kvantum colours for {mode} mode")


if __name__ == "__main__":
    main()
