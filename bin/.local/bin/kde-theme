        "ColorEffects:Inactive": {
            "ChangeSelectionColor": "true",
            "Color": bg,
            "ColorAmount": "0.025",
            "ColorEffect": "0",
            "ContrastAmount": "0.1",
            "ContrastEffect": "0",
            "Enable": "true",
            "IntensityAmount": "0",
            "IntensityEffect": "0",
