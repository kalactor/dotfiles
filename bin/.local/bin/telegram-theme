#!/usr/bin/env python3
"""Generate a Telegram Desktop theme from the wallust palette.

Telegram has no public "apply theme" command, so the generated theme must be
installed into its local profile once.  ``telegram-theme --install`` does that
by writing the theme into Telegram's encrypted ``tdata`` storage; after that,
Telegram watches ``~/.cache/rice/telegram.tdesktop-theme`` and reloads it
whenever ``theme-apply`` regenerates the file.

Usage:
  telegram-theme [light|dark] [--wallpaper PATH] [--check|--stdout] [--no-sync]
  telegram-theme --install [--tdata PATH] [--force]
  telegram-theme --status [--tdata PATH]

The palette is read from ``~/.cache/rice/colors.env`` (wallust) and the
upstream Telegram palette snapshot from
``~/.local/share/rice/telegram-base.tdesktop-palette``.  The package also
contains a soft, palette-tinted crop of the active wallpaper as
``background.jpg`` when ffmpeg is available.  After the one-time install,
every normal run keeps the copy stored in Telegram's ``tdata`` in sync, so a
wallpaper changed while Telegram was closed is correct on the next launch.
"""

from __future__ import annotations

import colorsys
import hashlib
import io
import os
import re
import secrets
import shutil
import struct
import subprocess
import sys
import tempfile
import zipfile
import zlib
from pathlib import Path

HOME = Path.home()
CACHE = HOME / ".cache" / "rice"
DATA = HOME / ".local" / "share" / "rice"
BASE_NAME = "telegram-base.tdesktop-palette"
THEME_NAME = "telegram.tdesktop-theme"
PALETTE_NAME = "telegram.tdesktop-palette"
DEFAULT_TDATA = HOME / ".local" / "share" / "TelegramDesktop" / "tdata"

HEX_VALUE = re.compile(r"^#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$")
PALETTE_LINE = re.compile(
    r"^(?P<prefix>[A-Za-z_][A-Za-z0-9_]*:\s*)(?P<value>[^;]+)(?P<suffix>;.*)$"
)
SEMANTIC_ANCHORS = (
    (0.000, "red"),
    (0.125, "yellow"),
    (0.403, "green"),
    (0.514, "cyan"),
    (0.611, "blue"),
    (0.903, "magenta"),
)

TDF_MAGIC = b"TDF$"
THEME_BLOCK = 0x54


# ── colour helpers ───────────────────────────────────────────────────────


def rgb(value: str) -> tuple[int, int, int]:
    match = HEX_VALUE.fullmatch(value.strip())
    if not match:
        raise ValueError(f"invalid colour: {value}")
    raw = match.group(1)
    return tuple(int(raw[index : index + 2], 16) for index in (0, 2, 4))


def hex_color(channels: tuple[float, float, float]) -> str:
    return "#{:02X}{:02X}{:02X}".format(
        *(max(0, min(255, round(channel))) for channel in channels)
    )


def mix(first: str, second: str, amount: float) -> str:
    one, two = rgb(first), rgb(second)
    return hex_color(
        tuple(a * (1.0 - amount) + b * amount for a, b in zip(one, two))
    )


def rgba(value: str, alpha: str) -> str:
    return value + alpha.lower()


def relative_luminance(value: str) -> float:
    channels = []
    for channel in rgb(value):
        normalized = channel / 255.0
        channels.append(
            normalized / 12.92
            if normalized <= 0.04045
            else ((normalized + 0.055) / 1.055) ** 2.4
        )
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]


def contrast_ratio(first: str, second: str) -> float:
    lighter, darker = sorted(
        (relative_luminance(first), relative_luminance(second)), reverse=True
    )
    return (lighter + 0.05) / (darker + 0.05)


def contrast_text(background: str, first: str, second: str) -> str:
    # Mid-tone wallpaper accents often have poor contrast against both the
    # palette foreground and the darker surface.  Add near-black/near-white
    # candidates tinted with the palette background so buttons stay readable.
    dark = mix(background, "#000000", 0.85)
    light = mix(background, "#FFFFFF", 0.85)
    candidates = (first, second, dark, light)
    return max(candidates, key=lambda color: contrast_ratio(background, color))


def nearest_semantic(hue: float, colors: dict[str, str]) -> str:
    name = min(
        SEMANTIC_ANCHORS,
        key=lambda item: min(
            abs(hue - item[0]), 1.0 - abs(hue - item[0])
        ),
    )[1]
    return colors[name]


# ── palette input ────────────────────────────────────────────────────────


def read_palette(path: Path | None = None) -> dict[str, str]:
    path = path or CACHE / "colors.env"
    palette: dict[str, str] = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        palette[key.strip()] = value.strip()
    required = (
        "background",
        "foreground",
        "color0",
        "color1",
        "color2",
        "color3",
        "color4",
        "color5",
        "color6",
        "color8",
        "color15",
    )
    missing = [key for key in required if key not in palette]
    if missing:
        raise SystemExit(f"telegram-theme: missing palette keys: {', '.join(missing)}")
    return palette


def base_palette_path() -> Path:
    script = Path(__file__).resolve()
    candidates = [DATA / BASE_NAME]
    if len(script.parents) > 3:
        candidates.append(
            script.parents[3]
            / "telegram"
            / ".local"
            / "share"
            / "rice"
            / BASE_NAME
        )
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise SystemExit(
        "telegram-theme: base palette not found; stow the telegram package"
    )


def mode_from_state() -> str:
    try:
        mode = (CACHE / "effective-mode").read_text().strip()
    except OSError:
        return "dark"
    return mode if mode in ("light", "dark") else "dark"


# ── palette generation ───────────────────────────────────────────────────


def semantic_colors(palette: dict[str, str], mode: str) -> dict[str, str]:
    background = palette["background"]
    foreground = palette["foreground"]
    accent = palette.get("accent", palette["color3"])
    accent_alt = palette.get("accent_alt", palette.get("color5", palette["color4"]))
    muted = palette.get("muted", palette["color8"])

    colors = {
        "background": background,
        "foreground": foreground,
        "accent": accent,
        "accent_alt": accent_alt,
        "muted": muted,
        "red": palette.get("danger", palette["color1"]),
        "yellow": palette.get("warning", palette["color3"]),
        "green": palette.get("success", palette["color2"]),
        "cyan": palette.get("info", palette["color6"]),
        "blue": palette.get("link", palette["color4"]),
        "magenta": accent_alt,
    }

    colors["selection"] = mix(
        background, accent, 0.30 if mode == "dark" else 0.15
    )
    colors["dark_background"] = mix(
        background, "#000000", 0.25 if mode == "dark" else 0.05
    )
    colors["darker_background"] = mix(
        background, "#000000", 0.45 if mode == "dark" else 0.10
    )
    colors["lighter_background"] = mix(
        background, foreground, 0.09 if mode == "dark" else 0.10
    )
    # Secondary text needs a much smaller fade on light backgrounds: mixing
    # 50% toward a light surface leaves roughly 2:1 contrast, which is too
    # faint for chat previews, dates and the empty-chat placeholder.
    colors["dark_foreground"] = mix(
        foreground, background, 0.15 if mode == "light" else 0.50
    )
    colors["light_foreground"] = mix(foreground, background, 0.12)
    colors["bright_foreground"] = foreground
    colors["active_foreground"] = contrast_text(
        accent, colors["bright_foreground"], colors["darker_background"]
    )
    colors["active_over"] = mix(accent, colors["bright_foreground"], 0.12)
    colors["active_ripple"] = mix(accent, colors["bright_foreground"], 0.22)
    colors["sent_background"] = mix(
        background, accent, 0.18 if mode == "dark" else 0.11
    )
    colors["sent_selected"] = mix(
        colors["sent_background"], colors["selection"], 0.58
    )
    colors["mode"] = mode
    return colors


