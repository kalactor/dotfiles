def recolor_literal(key: str, value: str, colors: dict[str, str]) -> str:
    match = HEX_VALUE.fullmatch(value.strip())
    if not match:
        return value.strip()

    source = tuple(
        int(match.group(1)[index : index + 2], 16) / 255 for index in (0, 2, 4)
    )
    hue, lightness, saturation = colorsys.rgb_to_hls(*source)

    inverted_surface = key.startswith(
        ("call", "groupCall", "mediaview", "toast", "msgDateImg", "videoPlay")
    )
    shadow_or_mask = any(
        marker in key.lower()
        for marker in ("shadow", "fadeout", "overlay", "scrim")
    )

    if saturation < 0.14 and shadow_or_mask and lightness < 0.08:
        target = "#000000"
    elif saturation < 0.14 and inverted_surface:
        target = mix(
            colors["darker_background"], colors["bright_foreground"], lightness
        )
    elif saturation < 0.14:
        target = mix(colors["foreground"], colors["background"], lightness)
    else:
        semantic = nearest_semantic(hue, colors)
        weight = max(0.16, 1.0 - abs(lightness - 0.5) * 1.75)
        backdrop = (
            colors["background"] if lightness >= 0.5 else colors["foreground"]
        )
        target = mix(backdrop, semantic, weight)

    return rgba(target, match.group(2)) if match.group(2) else target


def render_palette(base: str, colors: dict[str, str], mode: str) -> str:
    overrides = palette_overrides(colors)
    rendered: list[str] = [
        "// Generated by telegram-theme from the wallust palette. Do not edit.",
        f"// Mode: {mode}",
    ]
    seen: set[str] = set()

    for line in base.splitlines():
        match = PALETTE_LINE.match(line)
        if not match:
            rendered.append(line)
            continue
        key = match.group("prefix").split(":", 1)[0]
        if key in seen:
            raise SystemExit(f"telegram-theme: duplicate key in base palette: {key}")
        seen.add(key)
        value = overrides.get(
            key, recolor_literal(key, match.group("value"), colors)
        )
        rendered.append(match.group("prefix") + value + match.group("suffix"))

    missing = sorted(set(overrides) - seen)
    if missing:
        rendered.append("// Keys added after the bundled upstream palette snapshot.")
        rendered.extend(f"{key}: {overrides[key]};" for key in missing)

    return "\n".join(rendered) + "\n"


# ── package generation ───────────────────────────────────────────────────


def png_solid_color(color: str) -> bytes:
    pixel = bytes(rgb(color))

    def chunk(kind: bytes, data: bytes) -> bytes:
        checksum = zlib.crc32(kind + data) & 0xFFFFFFFF
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", checksum)
        )

    header = struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0)
    image = zlib.compress(b"\x00" + pixel)
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", image)
        + chunk(b"IEND", b"")
    )


def background_jpeg(
    color: str, mode: str, wallpaper: Path | None = None
) -> bytes | None:
    """Return a soft, palette-tinted crop of the active wallpaper.

    Telegram only looks for ``background.jpg`` in a theme package; the 1x1
    ``background.png`` is kept as a harmless fallback.  ffmpeg is optional: if
    it is missing or the wallpaper cannot be decoded, the theme still loads
    and Telegram keeps its own chat background.
    """
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        return None
    if wallpaper is None:
        try:
            wallpaper = (CACHE / "wallpaper").resolve(strict=True)
        except OSError:
            return None
    try:
        source = wallpaper.resolve(strict=True)
    except OSError:
        return None
    if not source.is_file():
        return None

    alpha = 0.60 if mode == "dark" else 0.55
    tint = f"0x{color.lstrip('#')}@{alpha:.2f}"
    filters = (
        "scale=1280:720:force_original_aspect_ratio=increase,"
        "crop=1280:720,"
        "gblur=sigma=45,"
        f"drawbox=x=0:y=0:w=iw:h=ih:color={tint}:t=fill"
    )
    descriptor, temporary = tempfile.mkstemp(suffix=".jpg")
    os.close(descriptor)
    try:
        result = subprocess.run(
            [
                ffmpeg,
                "-nostdin",
                "-y",
                "-loglevel",
                "error",
                "-i",
                str(source),
                "-vf",
                filters,
                "-frames:v",
                "1",
                "-q:v",
                "4",
                temporary,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=20,
        )
        if result.returncode != 0:
            return None
        return Path(temporary).read_bytes()
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def build_theme_package(
    palette: str, wallpaper_color: str, background: bytes | None = None
) -> bytes:
    entries = [
        ("colors.tdesktop-theme", palette.encode("utf-8")),
        ("background.png", png_solid_color(wallpaper_color)),
    ]
    if background is not None:
        entries.append(("background.jpg", background))

    output = io.BytesIO()
    with zipfile.ZipFile(output, "w") as archive:
        for name, content in entries:
            entry = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            entry.compress_type = zipfile.ZIP_STORED
            entry.create_system = 3
            entry.external_attr = 0o644 << 16
            archive.writestr(entry, content)
    return output.getvalue()


def write_if_changed(path: Path, data: bytes) -> bool:
    try:
        if path.read_bytes() == data:
            return False
    except FileNotFoundError:
        pass

    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}."
    )
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return True


# ── Telegram tdata support (one-time install / status) ───────────────────


def qt_ba(data: bytes | None) -> bytes:
    if data is None:
        return struct.pack(">I", 0xFFFFFFFF)
    return struct.pack(">I", len(data)) + data


def qt_str(value: str | None) -> bytes:
    if value is None:
        return struct.pack(">I", 0xFFFFFFFF)
    encoded = value.encode("utf-16-be")
    return struct.pack(">I", len(encoded)) + encoded


def read_qt_ba(data: bytes, position: int) -> tuple[bytes | None, int]:
    size = struct.unpack_from(">I", data, position)[0]
    position += 4
    if size == 0xFFFFFFFF:
        return None, position
    return bytes(data[position : position + size]), position + size


def read_qt_str(data: bytes, position: int) -> tuple[str | None, int]:
    size = struct.unpack_from(">I", data, position)[0]
    position += 4
    if size == 0xFFFFFFFF:
        return None, position
    return data[position : position + size].decode("utf-16-be", errors="replace"), position + size


def derive_key(salt: bytes) -> bytes:
    return hashlib.pbkdf2_hmac("sha1", b"", salt, 4, dklen=256)


def prepare_aes(msg_key: bytes, auth_key: bytes) -> tuple[bytes, bytes]:
    offset = 8
    sha1_a = hashlib.sha1(msg_key + auth_key[offset : offset + 32]).digest()
    sha1_b = hashlib.sha1(
        auth_key[32 + offset : 48 + offset]
        + msg_key
        + auth_key[48 + offset : 64 + offset]
    ).digest()
    sha1_c = hashlib.sha1(auth_key[64 + offset : 96 + offset] + msg_key).digest()
    sha1_d = hashlib.sha1(msg_key + auth_key[96 + offset : 128 + offset]).digest()
    aes_key = sha1_a[0:8] + sha1_b[8:20] + sha1_c[4:16]
    aes_iv = sha1_a[8:20] + sha1_b[0:8] + sha1_c[16:20] + sha1_d[0:8]
    return aes_key, aes_iv


def aes_ige(data: bytes, key: bytes, iv: bytes, encrypt: bool) -> bytes:
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

    cipher = Cipher(algorithms.AES(key), modes.ECB())
    worker = cipher.encryptor() if encrypt else cipher.decryptor()
    previous_cipher, previous_plain = iv[:16], iv[16:]
    output = bytearray()
    for index in range(0, len(data), 16):
        block = data[index : index + 16]
        if encrypt:
            encrypted = bytes(
                a ^ b
                for a, b in zip(
                    worker.update(
                        bytes(a ^ b for a, b in zip(block, previous_cipher))
                    ),
                    previous_plain,
                )
            )
            output += encrypted
            previous_cipher, previous_plain = encrypted, block
        else:
            plain = bytes(
                a ^ b
                for a, b in zip(
                    worker.update(
                        bytes(a ^ b for a, b in zip(block, previous_plain))
                    ),
                    previous_cipher,
                )
            )
            output += plain
            previous_cipher, previous_plain = block, plain
    return bytes(output)


def encrypt_local(data: bytes, auth_key: bytes) -> bytes:
    size = 4 + len(data)
    padded_size = size + (16 - size % 16) % 16
    full = struct.pack("<I", size) + data + secrets.token_bytes(padded_size - size)
    msg_key = hashlib.sha1(full).digest()[:16]
    aes_key, aes_iv = prepare_aes(msg_key, auth_key)
    return msg_key + aes_ige(full, aes_key, aes_iv, encrypt=True)


def decrypt_local(encrypted: bytes, auth_key: bytes) -> bytes:
    msg_key, encrypted_data = encrypted[:16], encrypted[16:]
    aes_key, aes_iv = prepare_aes(msg_key, auth_key)
    decrypted = aes_ige(encrypted_data, aes_key, aes_iv, encrypt=False)
    if hashlib.sha1(decrypted).digest()[:16] != msg_key:
        raise ValueError("invalid Telegram local-storage key or corrupted data")
    return decrypted[4 : struct.unpack_from("<I", decrypted)[0]]


def find_settings_file(tdata: Path) -> Path:
    for suffix in ("s", "0", "1"):
        candidate = Path(str(tdata / "settings") + suffix)
        if candidate.is_file() and candidate.read_bytes()[:4] == TDF_MAGIC:
            return candidate
    raise SystemExit(f"telegram-theme: no encrypted settings file in {tdata}")


def read_tdf_file(path: Path) -> tuple[bytes, int]:
    raw = path.read_bytes()
    if raw[:4] != TDF_MAGIC:
        raise SystemExit(f"telegram-theme: {path} is not a TDF file")
    version = struct.unpack_from("<i", raw, 4)[0]
    return raw[8:-16], version


def write_tdf_file(path: Path, payload: bytes, version: int) -> None:
    header = TDF_MAGIC + struct.pack("<i", version)
    digest_input = (
        payload
        + struct.pack("<i", len(payload))
        + struct.pack("<i", version)
        + TDF_MAGIC
    )
    digest = hashlib.md5(digest_input).digest()
    write_if_changed(path, header + payload + digest)


def key_to_filename(key: int) -> str:
    result = []
    for _ in range(16):
        nibble = key & 0x0F
        result.append(
            chr(ord("0") + nibble) if nibble < 10 else chr(ord("A") + nibble - 10)
        )
        key >>= 4
    return "".join(result)


def theme_file_for(tdata: Path, key: int) -> Path:
    return Path(str(tdata / key_to_filename(key)) + "s")


def read_theme_inner(path: Path, auth_key: bytes) -> bytes | None:
    if not path.is_file():
        return None
    raw = path.read_bytes()
    if raw[:4] != TDF_MAGIC:
        return None
    payload = raw[8:-16]
    encrypted, _ = read_qt_ba(payload, 0)
    if encrypted is None:
        return None
    try:
        return decrypt_local(encrypted, auth_key)
    except Exception:
        return None


def theme_block(data: bytes, tdata: Path) -> tuple[int | None, int, int, bool]:
    marker = struct.pack(">I", THEME_BLOCK)
    fallback: tuple[int | None, int, int, bool] = (None, 0, 0, False)
    position = data.find(marker)
    while position != -1:
        if position + 24 <= len(data):
            day, night = struct.unpack_from(">QQ", data, position + 4)
            night_mode = bool(struct.unpack_from(">I", data, position + 20)[0])
            active = night if night_mode else day
            if active == 0 or theme_file_for(tdata, active).is_file():
                return position, day, night, night_mode
            if fallback[0] is None:
                fallback = (position, day, night, night_mode)
        position = data.find(marker, position + 1)
    return fallback


def new_key(tdata: Path) -> int:
    while True:
        key = secrets.randbits(64)
        if key and not theme_file_for(tdata, key).exists():
            return key


def write_theme_file(
    tdata: Path,
    key: int,
    content: bytes,
    theme_path: Path,
    auth_key: bytes,
    version: int,
) -> Path:
    target = theme_file_for(tdata, key)
    old_inner = read_theme_inner(target, auth_key)
    suffix = b""
    if old_inner is not None:
        position = 0
        _, position = read_qt_ba(old_inner, position)
        _, position = read_qt_str(old_inner, position)
        _, position = read_qt_str(old_inner, position)
        _, position = read_qt_str(old_inner, position)
        suffix = old_inner[position:]
    if not suffix:
        suffix = (
            struct.pack(">QQ", 0, 0)
            + qt_str("")
            + qt_str("")
            + struct.pack(">Q", 0)
            + struct.pack(">i", 0)
            + struct.pack(">ii", 0, 0)
            + qt_ba(None)
            + qt_ba(None)
            + struct.pack(">I", 0)
        )

    inner = (
        qt_ba(content)
        + qt_str("special://new_tag")
        + qt_str(str(theme_path.resolve()))
        + qt_str(str(theme_path))
        + suffix
    )
    encrypted = qt_ba(encrypt_local(inner, auth_key))
    write_tdf_file(target, encrypted, version)
    return target


def sync_theme(tdata: Path, theme_path: Path, content: bytes) -> bool:
    """Keep the installed tdata theme current without touching settings.

    Telegram loads the theme stored in tdata at startup and only watches the
    cache file afterwards.  Syncing the keyed file here means a wallpaper
    changed while Telegram was closed is still correct on the next launch.
    """
    try:
        settings_path = find_settings_file(tdata)
        payload, version = read_tdf_file(settings_path)
        salt, position = read_qt_ba(payload, 0)
        encrypted, _ = read_qt_ba(payload, position)
        if salt is None or encrypted is None:
            return False
        auth_key = derive_key(salt)
        data = decrypt_local(encrypted, auth_key)
    except (SystemExit, OSError, ValueError, struct.error):
        return False

    offset, day, night, night_mode = theme_block(data, tdata)
    active = night if night_mode else day
    if not active:
        return False

    target = theme_file_for(tdata, active)
    old_inner = read_theme_inner(target, auth_key)
    if old_inner is not None:
        old_content, _ = read_qt_ba(old_inner, 0)
        if old_content == content:
            return False

    write_theme_file(tdata, active, content, theme_path, auth_key, version)
    return True


def install_theme(tdata: Path, theme_path: Path, content: bytes, force: bool) -> None:
    if not tdata.is_dir():
        raise SystemExit(f"telegram-theme: tdata directory not found: {tdata}")
    running = any(
        subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0
        for name in ("Telegram", "telegram-desktop")
    )
    if not force and running:
        raise SystemExit(
            "telegram-theme: quit Telegram before installing the theme "
            "(or pass --force)"
        )

    settings_path = find_settings_file(tdata)
    payload, version = read_tdf_file(settings_path)
    salt, position = read_qt_ba(payload, 0)
    encrypted, _ = read_qt_ba(payload, position)
    if salt is None or encrypted is None:
        raise SystemExit(f"telegram-theme: unsupported settings file: {settings_path}")
    auth_key = derive_key(salt)
    data = decrypt_local(encrypted, auth_key)

    offset, day, night, night_mode = theme_block(data, tdata)
    active = night if night_mode else day
    key = active or new_key(tdata)

    patched = bytearray(data)
    if offset is None:
        patched += (
            struct.pack(">I", THEME_BLOCK)
            + struct.pack(">QQ", key, key)
            + struct.pack(">I", 1 if night_mode else 0)
        )
    else:
        struct.pack_into(">Q", patched, offset + 4, key)
        struct.pack_into(">Q", patched, offset + 12, key)

    new_settings = qt_ba(salt) + qt_ba(encrypt_local(bytes(patched), auth_key))
    write_tdf_file(settings_path, new_settings, version)
    target = write_theme_file(tdata, key, content, theme_path, auth_key, version)

    print(f"telegram-theme: installed {theme_path.name}")
    print(f"  settings: {settings_path}")
    print(f"  key:      0x{key:016X} -> {target.name}")
    print("  launch Telegram; it will watch the theme file for future updates")


def status(tdata: Path) -> int:
    try:
        settings_path = find_settings_file(tdata)
    except SystemExit as error:
        print(error)
        return 1
    payload, _ = read_tdf_file(settings_path)
    salt, position = read_qt_ba(payload, 0)
    encrypted, _ = read_qt_ba(payload, position)
    if salt is None or encrypted is None:
        raise SystemExit(f"telegram-theme: unsupported settings file: {settings_path}")
    auth_key = derive_key(salt)
    data = decrypt_local(encrypted, auth_key)
    offset, day, night, night_mode = theme_block(data, tdata)
    active = night if night_mode else day
    target = theme_file_for(tdata, active) if active else None
    print(f"settings:   {settings_path}")
    print(f"day key:    0x{day:016X}")
    print(f"night key:  0x{night:016X}")
    print(f"night mode: {'yes' if night_mode else 'no'}")
    if target and target.is_file():
        inner = read_theme_inner(target, auth_key)
        content = None
        if inner is not None:
            content, _ = read_qt_ba(inner, 0)
        cache = CACHE / THEME_NAME
        if content is not None and cache.is_file() and content == cache.read_bytes():
            print(
                f"active:     0x{active:016X} -> {target.name} "
                f"({target.stat().st_size} bytes, in sync)"
            )
            return 0
        print(
            f"active:     0x{active:016X} -> {target.name} "
            f"({target.stat().st_size} bytes, stale)"
        )
        return 1
    print("active:     default Telegram theme (not installed)")
    return 1


# ── main ─────────────────────────────────────────────────────────────────


def main() -> int:
    arguments = sys.argv[1:]
    flags = {argument for argument in arguments if argument.startswith("--")}
    values: dict[str, str] = {}
    positional: list[str] = []
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in (
            "--tdata",
            "--palette",
            "--mode",
            "--wallpaper",
        ) and index + 1 < len(arguments):
            values[argument] = arguments[index + 1]
            index += 2
            continue
        if not argument.startswith("--"):
            positional.append(argument)
        index += 1

    mode = values.get("--mode") or (positional[0] if positional else "")
    if mode not in ("light", "dark"):
        mode = mode_from_state()

    tdata = Path(values["--tdata"]).expanduser() if "--tdata" in values else DEFAULT_TDATA
    palette_path = (
        Path(values["--palette"]).expanduser() if "--palette" in values else None
    )
    wallpaper_path = (
        Path(values["--wallpaper"]).expanduser() if "--wallpaper" in values else None
    )

    if "--status" in flags:
        return status(tdata)

    palette = read_palette(palette_path)
    base = base_palette_path().read_text()
    colors = semantic_colors(palette, mode)
    text = render_palette(base, colors, mode)

    if "--stdout" in flags:
        sys.stdout.write(text)
        return 0

    background = background_jpeg(colors["background"], mode, wallpaper_path)
    package = build_theme_package(text, colors["background"], background)

    if "--check" in flags:
        print(
            f"telegram-theme: valid {len(text.splitlines())} palette lines "
            f"({mode}, {len(package)} bytes)"
        )
        return 0

    changed = False
    for name in (PALETTE_NAME, THEME_NAME):
        changed |= write_if_changed(CACHE / name, package)

    if "--install" in flags:
        install_theme(
            tdata,
            CACHE / THEME_NAME,
            package,
            force="--force" in flags,
        )
        return 0

    synced = False
    if "--no-sync" not in flags:
        synced = sync_theme(tdata, CACHE / THEME_NAME, package)

    print(
        f"telegram-theme: {'wrote' if changed else 'unchanged'} "
        f"~/.cache/rice/{THEME_NAME} ({mode})"
        + ("; tdata synced" if synced else "")
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
