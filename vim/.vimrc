" ~/.vimrc — vim + vim-plug + coc.nvim, colors from wallust
set nocompatible
filetype plugin indent on
set termguicolors

" Follow the desktop light/dark mode for Vim's default background. The
" generated wallust colorscheme also sets this; this is the pre-colorscheme
" fallback and keeps :set background in sync after a mode change.
function! s:RiceMode() abort
  let l:file = expand('~/.cache/rice/effective-mode')
  if filereadable(l:file)
    let l:lines = readfile(l:file, '', 1)
    if !empty(l:lines) && l:lines[0] =~# '^light$'
      return 'light'
    endif
  endif
  return 'dark'
endfunction

if s:RiceMode() ==# 'light'
  set background=light
else
  set background=dark
endif

syntax enable

" Look
set number
set relativenumber
set cursorline
set signcolumn=yes
set showcmd
set laststatus=2
set scrolloff=8

" Editing
set tabstop=4
set shiftwidth=4
set expandtab
set smartindent
set ignorecase
set smartcase
set incsearch
set hlsearch
set mouse=a
set clipboard=unnamedplus
set updatetime=300
set splitright
set splitbelow

call plug#begin()
Plug 'neoclide/coc.nvim', {'branch': 'release'}
call plug#end()

" Generated by wallust (theme-apply / wall). Ignore if it does not exist yet.
silent! colorscheme wallust

" Live-reload the generated colorscheme when the wallpaper changes.
function! s:WallustReload(...) abort
  let l:file = expand('~/.vim/colors/wallust.vim')
  if !filereadable(l:file)
    return
  endif
  let l:mtime = getftime(l:file)
  if l:mtime != get(g:, 'wallust_colors_mtime', -1)
    let g:wallust_colors_mtime = l:mtime
    if s:RiceMode() ==# 'light'
      set background=light
    else
      set background=dark
    endif
    silent! colorscheme wallust
  endif
endfunction

augroup WallustLive
  autocmd!
  autocmd FocusGained * call s:WallustReload()
augroup END

if has('timers')
  let g:wallust_colors_mtime = getftime(expand('~/.vim/colors/wallust.vim'))
  call timer_start(2000, function('s:WallustReload'), {'repeat': -1})
endif
