" ~/.vimrc — vim + vim-plug + coc.nvim, colors from wallust
set nocompatible
filetype plugin indent on
syntax enable
set termguicolors
set background=dark

" Look
set number
set relativenumber
set cursorline
set signcolumn=yes
set showcmd
set laststatus=2
set scrolloff=8

" Editing
set tabstop=4
set shiftwidth=4
set expandtab
set smartindent
set ignorecase
set smartcase
set incsearch
set hlsearch
set mouse=a
set clipboard=unnamedplus
set updatetime=300
set splitright
set splitbelow

call plug#begin()
Plug 'neoclide/coc.nvim', {'branch': 'release'}
call plug#end()

" Generated by wallust (theme-apply / wall). Ignore if it does not exist yet.
silent! colorscheme wallust
