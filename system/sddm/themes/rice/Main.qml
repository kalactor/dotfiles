import QtQuick 2.15
import SddmComponents 2.0

Rectangle {
    id: root
    width: 1920
    height: 1080

    property int sessionIndex: session.index

    // Palette is generated by wallust and copied in by theme-apply.
    Colors { id: palette }

    TextConstants { id: textConstants }

    Connections {
        target: sddm

        onLoginSucceeded: {
            errorMessage.color = palette.accentAlt
            errorMessage.text = textConstants.loginSucceeded
        }
        onLoginFailed: {
            password.text = ""
            errorMessage.color = palette.danger
            errorMessage.text = textConstants.loginFailed
        }
        onInformationMessage: {
            errorMessage.color = palette.danger
            errorMessage.text = message
        }
    }

    Background {
        anchors.fill: parent
        source: Qt.resolvedUrl("background.jpg")
        fillMode: Image.PreserveAspectCrop
    }

    // Darken the wallpaper so the card and clock stay readable
    Rectangle {
        anchors.fill: parent
        color: palette.bg
        opacity: 0.55
    }

    // Clock, top-left
    Column {
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.margins: 64
        spacing: 6

        Text {
            id: clockText
            color: palette.fg
            font.family: "JetBrainsMono Nerd Font"
            font.pixelSize: 64
            font.bold: true
            text: Qt.formatTime(new Date(), "HH:mm")
        }

        Text {
            id: dateText
            color: palette.muted
            font.family: "JetBrainsMono Nerd Font"
            font.pixelSize: 18
            text: Qt.formatDate(new Date(), "dddd, dd MMMM")
        }

        Timer {
            interval: 1000
            running: true
            repeat: true
            onTriggered: {
                clockText.text = Qt.formatTime(new Date(), "HH:mm")
                dateText.text = Qt.formatDate(new Date(), "dddd, dd MMMM")
            }
        }
    }

    // Login card
    Rectangle {
        id: card
        anchors.centerIn: parent
        width: 400
        height: content.implicitHeight + 64
        radius: 24
        color: Qt.rgba(palette.bg.r, palette.bg.g, palette.bg.b, 0.90)
        border.width: 1
        border.color: palette.accent

        Column {
            id: content
            anchors.centerIn: parent
            width: parent.width - 64
            spacing: 14

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                color: palette.fg
                text: "Welcome back"
                font.family: "Inter"
                font.pixelSize: 26
                font.bold: true
            }

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                color: palette.muted
                text: sddm.hostName
                font.family: "JetBrainsMono Nerd Font"
                font.pixelSize: 12
            }

            Text {
                color: palette.muted
                text: textConstants.userName
                font.family: "Inter"
                font.pixelSize: 12
                font.bold: true
            }

            TextBox {
                id: name
                width: parent.width
                height: 42
                text: userModel.lastUser
                color: palette.fieldBg
                textColor: palette.fg
                borderColor: palette.muted
                focusColor: palette.accent
                hoverColor: palette.accentAlt
                radius: 10
                font.family: "Inter"
                font.pixelSize: 14

                KeyNavigation.tab: password
                Keys.onPressed: {
                    if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                        sddm.login(name.text, password.text, sessionIndex)
                        event.accepted = true
                    }
                }
            }

            Text {
                color: palette.muted
                text: textConstants.password
                font.family: "Inter"
                font.pixelSize: 12
                font.bold: true
            }

            PasswordBox {
                id: password
                width: parent.width
                height: 42
                color: palette.fieldBg
                textColor: palette.fg
                borderColor: palette.muted
                focusColor: palette.accent
                hoverColor: palette.accentAlt
                radius: 10
                font.family: "Inter"
                font.pixelSize: 14

                KeyNavigation.tab: session
                Keys.onPressed: {
                    if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                        sddm.login(name.text, password.text, sessionIndex)
                        event.accepted = true
                    }
                }
            }

            Text {
                color: palette.muted
                text: textConstants.session
                font.family: "Inter"
                font.pixelSize: 12
                font.bold: true
            }

            ComboBox {
                id: session
                width: parent.width
                height: 38
                color: palette.fieldBg
                borderColor: palette.muted
                focusColor: palette.accent
                hoverColor: palette.accentAlt
                textColor: palette.fg
                menuColor: palette.bg
                arrowColor: palette.fieldBg
                arrowIcon: Qt.resolvedUrl("angle-down.png")
                font.family: "Inter"
                font.pixelSize: 13

                model: sessionModel
                index: sessionModel.lastIndex

                KeyNavigation.tab: loginButton
            }

            Text {
                id: errorMessage
                width: parent.width
                color: palette.muted
                text: textConstants.prompt
                font.family: "Inter"
                font.pixelSize: 11
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 10

                Button {
                    id: loginButton
                    width: 132
                    height: 40
                    text: textConstants.login
                    color: palette.accent
                    activeColor: palette.accentAlt
                    pressedColor: palette.muted
                    textColor: palette.bg
                    borderColor: palette.accent
                    font.family: "Inter"
                    font.pixelSize: 13
                    font.bold: true

                    KeyNavigation.tab: rebootButton
                    onClicked: sddm.login(name.text, password.text, sessionIndex)
                }

                Button {
                    id: rebootButton
                    width: 96
                    height: 40
                    text: textConstants.reboot
                    color: palette.fieldBg
                    activeColor: palette.accentAlt
                    pressedColor: palette.accent
                    textColor: palette.fg
                    borderColor: palette.muted
                    font.family: "Inter"
                    font.pixelSize: 13

                    KeyNavigation.tab: shutdownButton
                    onClicked: sddm.reboot()
                }

                Button {
                    id: shutdownButton
                    width: 96
                    height: 40
                    text: textConstants.shutdown
                    color: palette.fieldBg
                    activeColor: palette.danger
                    pressedColor: palette.danger
                    textColor: palette.fg
                    borderColor: palette.muted
                    font.family: "Inter"
                    font.pixelSize: 13

                    KeyNavigation.tab: name
                    onClicked: sddm.powerOff()
                }
            }
        }
    }

    Component.onCompleted: {
        if (name.text === "")
            name.focus = true
        else
            password.focus = true
    }
}
