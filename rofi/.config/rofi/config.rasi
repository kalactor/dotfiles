@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "󰀻  Apps";
    display-run: "󰆍  Run";
    display-window: "󰖯  Windows";
    font: "JetBrainsMono Nerd Font 11";
    matching: "fuzzy";
    sort: true;
    monitor: "-1";
}

* {
    background-color: transparent;
    text-color: @fg;

    /* Rofi's built-in state variables, mapped onto the wallust palette */
    normal-background: transparent;
    normal-foreground: @fg;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @fg;
    selected-normal-background: @selection;
    selected-normal-foreground: @accent;
    selected-active-background: @selection;
    selected-active-foreground: @accent;
    selected-urgent-background: @urgent;
    selected-urgent-foreground: @fg;
    active-background: @selection;
    active-foreground: @accent;
    urgent-background: @urgent;
    urgent-foreground: @bg;
}

window {
    width: 40%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @border;
    border-radius: 20px;
    background-color: @bg;
    padding: 8px;
}

mainbox {
    padding: 16px;
    spacing: 14px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 14px 16px;
    spacing: 12px;
    border: 1px;
    border-color: @selection-border;
    border-radius: 14px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    text-color: @fg;
    placeholder: "Search something...";
    placeholder-color: @muted;
    background-color: transparent;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 7px;
    fixed-height: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 11px 13px;
    border-radius: 12px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selection;
    text-color: @accent;
    border: 1px;
    border-color: @selection-border;
}

element-icon {
    size: 28px;
    background-color: transparent;
    margin: 0px 12px 0px 0px;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
}
