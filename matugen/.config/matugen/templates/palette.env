# Generated by matugen — base palette + Material 3 roles.
# rice-contrast enforces contrast and renders the application templates.
background={{ colors.background.default.hex }}
foreground={{ colors.on_background.default.hex }}
cursor={{ colors.primary.default.hex }}
color0={{ palettes.neutral._10.hex }}
color1={{ colors.primary.default.hex | to_color | set_hue: 25 }}
color2={{ colors.primary.default.hex | to_color | set_hue: 145 }}
color3={{ colors.primary.default.hex | to_color | set_hue: 85 }}
color4={{ colors.primary.default.hex | to_color | set_hue: 255 }}
color5={{ colors.primary.default.hex | to_color | set_hue: 325 }}
color6={{ colors.primary.default.hex | to_color | set_hue: 195 }}
color7={{ palettes.neutral._90.hex }}
color8={{ colors.on_surface_variant.default.hex }}
color9={{ colors.primary.default.hex | to_color | lighten: 6.0 | set_hue: 25 }}
color10={{ colors.primary.default.hex | to_color | lighten: 6.0 | set_hue: 145 }}
color11={{ colors.primary.default.hex | to_color | lighten: 6.0 | set_hue: 85 }}
color12={{ colors.primary.default.hex | to_color | lighten: 6.0 | set_hue: 255 }}
color13={{ colors.primary.default.hex | to_color | lighten: 6.0 | set_hue: 325 }}
color14={{ colors.primary.default.hex | to_color | lighten: 6.0 | set_hue: 195 }}
color15={{ palettes.neutral._99.hex }}

# Material roles consumed by rice-contrast for semantic UI colours.
surface={{ colors.surface_container_low.default.hex }}
surface_alt={{ colors.surface_container.default.hex }}
surface_fg={{ colors.on_surface.default.hex }}
bar_bg={{ colors.surface_container.default.hex }}
bar_fg={{ colors.on_surface.default.hex }}
muted={{ colors.on_surface_variant.default.hex }}
border={{ colors.outline.default.hex }}
accent={{ colors.primary.default.hex }}
accent_alt={{ colors.tertiary.default.hex }}
accent_source={{ colors.primary.default.hex }}
accent_alt_source={{ colors.tertiary.default.hex }}
danger={{ colors.error.default.hex }}
success={{ colors.primary.default.hex | to_color | set_hue: 145 }}
warning={{ colors.primary.default.hex | to_color | set_hue: 85 }}
info={{ colors.primary.default.hex | to_color | set_hue: 195 }}
link={{ colors.primary.default.hex | to_color | set_hue: 255 }}
selection_bg={{ colors.primary.default.hex }}
selection_fg={{ colors.on_primary.default.hex }}
