" Generated by wallust — do not edit by hand.
" theme-apply rewrites the next line to match light/dark mode.
set background=dark
highlight clear
if exists("syntax_on")
  syntax reset
endif
let g:colors_name = "wallust"

hi Normal       guifg={{ foreground }} guibg={{ background }}
hi Comment      guifg={{ color8 }}
hi Constant     guifg={{ color4 }}
hi String       guifg={{ color2 }}
hi Character    guifg={{ color2 }}
hi Number       guifg={{ color4 }}
hi Boolean      guifg={{ color4 }}
hi Identifier   guifg={{ color6 }}
hi Function     guifg={{ color3 }}
hi Statement    guifg={{ color1 }}
hi Keyword      guifg={{ color1 }}
hi Operator     guifg={{ color5 }}
hi PreProc      guifg={{ color4 }}
hi Type         guifg={{ color5 }}
hi Special      guifg={{ color5 }}
hi Underlined   guifg={{ color6 }} gui=underline
hi Error        guifg={{ background }} guibg={{ color1 }}
hi Todo         guifg={{ background }} guibg={{ color3 }}

hi LineNr       guifg={{ color8 }}
hi CursorLine   guibg={{ color0 }}
hi CursorLineNr guifg={{ color3 }} gui=bold
hi Visual       guibg={{ color0 }}
hi Search       guifg={{ background }} guibg={{ color4 }}
hi IncSearch    guifg={{ background }} guibg={{ color3 }}
hi MatchParen   guifg={{ color3 }} gui=bold
hi Pmenu        guifg={{ foreground }} guibg={{ color0 }}
hi PmenuSel     guifg={{ background }} guibg={{ color3 }}
hi StatusLine   guifg={{ foreground }} guibg={{ color0 }}
hi StatusLineNC guifg={{ color8 }} guibg={{ color0 }}
hi VertSplit    guifg={{ color8 }} guibg={{ background }}
hi SignColumn   guifg={{ color8 }} guibg={{ background }}
hi DiagnosticError guifg={{ color1 }}
hi DiagnosticWarn  guifg={{ color4 }}
hi DiagnosticInfo  guifg={{ color6 }}
hi DiagnosticHint  guifg={{ color5 }}
