" Generated by wallust + rice-contrast — do not edit by hand.
" theme-apply rewrites the next line to match light/dark mode.
set background=dark
highlight clear
if exists("syntax_on")
  syntax reset
endif
let g:colors_name = "wallust"

hi Normal       guifg={{ foreground }} guibg={{ background }}
hi Comment      guifg={{ muted }}
hi Constant     guifg={{ info }}
hi String       guifg={{ success }}
hi Character    guifg={{ success }}
hi Number       guifg={{ link }}
hi Boolean      guifg={{ link }}
hi Identifier   guifg={{ accent_alt }}
hi Function     guifg={{ accent }}
hi Statement    guifg={{ danger }}
hi Keyword      guifg={{ danger }}
hi Operator     guifg={{ warning }}
hi PreProc      guifg={{ link }}
hi Type         guifg={{ accent_alt }}
hi Special      guifg={{ warning }}
hi Underlined   guifg={{ link }} gui=underline
hi Error        guifg={{ danger_fg }} guibg={{ danger }}
hi Todo         guifg={{ warning_fg }} guibg={{ warning }}

hi LineNr       guifg={{ muted }}
hi CursorLine   guibg={{ surface }}
hi CursorLineNr guifg={{ accent }} gui=bold
hi Visual       guibg={{ surface_alt }}
hi Search       guifg={{ accent_fg }} guibg={{ accent }}
hi IncSearch    guifg={{ accent_fg }} guibg={{ accent }}
hi MatchParen   guifg={{ accent }} gui=bold
hi Pmenu        guifg={{ surface_fg }} guibg={{ surface }}
hi PmenuSel     guifg={{ accent_fg }} guibg={{ accent }}
hi StatusLine   guifg={{ surface_fg }} guibg={{ surface }}
hi StatusLineNC guifg={{ muted }} guibg={{ surface }}
hi VertSplit    guifg={{ border }} guibg={{ background }}
hi SignColumn   guifg={{ muted }} guibg={{ background }}
hi DiagnosticError guifg={{ danger }}
hi DiagnosticWarn  guifg={{ warning }}
hi DiagnosticInfo  guifg={{ info }}
hi DiagnosticHint  guifg={{ accent_alt }}
