# Generated by wallust + rice-contrast — do not edit by hand.
# btop theme: semantic surfaces, accent borders, status colours only for state.
theme[main_bg]="{{ background }}"
theme[main_fg]="{{ foreground }}"
theme[title]="{{ accent }}"
theme[hi_fg]="{{ accent_alt }}"
theme[selected_bg]="{{ surface }}"
theme[selected_fg]="{{ surface_fg }}"
theme[inactive_fg]="{{ muted }}"
theme[proc_misc]="{{ info }}"
theme[cpu_box]="{{ accent }}"
theme[mem_box]="{{ accent }}"
theme[net_box]="{{ accent }}"
theme[proc_box]="{{ accent }}"
theme[div_line]="{{ border }}"
theme[temp_start]="{{ success }}"
theme[temp_mid]="{{ warning }}"
theme[temp_end]="{{ danger }}"
theme[cpu_start]="{{ success }}"
theme[cpu_mid]="{{ warning }}"
theme[cpu_end]="{{ danger }}"
theme[free_start]="{{ success }}"
theme[free_mid]="{{ accent }}"
theme[free_end]="{{ link }}"
theme[cached_start]="{{ link }}"
theme[cached_mid]="{{ info }}"
theme[cached_end]="{{ accent }}"
theme[available_start]="{{ success }}"
theme[available_mid]="{{ link }}"
theme[available_end]="{{ info }}"
theme[used_start]="{{ warning }}"
theme[used_mid]="{{ accent_alt }}"
theme[used_end]="{{ danger }}"
theme[download_start]="{{ link }}"
theme[download_mid]="{{ info }}"
theme[download_end]="{{ accent }}"
theme[upload_start]="{{ accent_alt }}"
theme[upload_mid]="{{ warning }}"
theme[upload_end]="{{ danger }}"
theme[process_start]="{{ success }}"
theme[process_mid]="{{ warning }}"
theme[process_end]="{{ danger }}"
