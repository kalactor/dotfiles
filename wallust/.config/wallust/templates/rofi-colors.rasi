/* Generated by wallust + rice-contrast — do not edit by hand. */
* {
    bg:         {{ background }}ee;
    bg-alt:     {{ surface }}ee;
    fg:         {{ foreground }};
    muted:      {{ muted }};
    accent:     {{ accent }};
    accent-alt: {{ accent_alt }};
    border:     {{ border }}80;
    selection:  {{ accent }}30;
    selection-border: {{ accent }}70;
    urgent:     {{ danger }};
}
